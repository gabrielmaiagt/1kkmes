rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member(offerId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/offers/$(offerId)).data.memberUids;
    }
    match /offers/{offerId} {
      allow read: if member(offerId);
      allow write: if false;
      function validResource(recordId) {
        return request.resource.data.id == recordId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 253
          && request.resource.data.url is string
          && request.resource.data.url.size() <= 2000
          && (request.resource.data.url == '' || request.resource.data.url.matches('^https?://.*'))
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 2000
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.createdAt is string;
      }
      match /domains/{recordId} {
        allow read, delete: if member(offerId);
        allow create, update: if member(offerId)
          && request.resource.data.keys().hasAll(['id', 'name', 'url', 'notes', 'date', 'createdAt', 'status'])
          && request.resource.data.keys().hasOnly(['id', 'name', 'url', 'notes', 'date', 'createdAt', 'status'])
          && validResource(recordId)
          && request.resource.data.url.size() > 0
          && request.resource.data.status in ['active', 'rejected'];
      }
      match /creatives/{recordId} {
        allow read, delete: if member(offerId);
        allow create, update: if member(offerId)
          && request.resource.data.keys().hasAll(['id', 'name', 'url', 'notes', 'date', 'createdAt'])
          && request.resource.data.keys().hasOnly(['id', 'name', 'url', 'notes', 'date', 'createdAt'])
          && validResource(recordId);
      }
      match /entries/{entryId} {
        allow read, delete: if member(offerId);
        allow create, update: if member(offerId)
          && request.resource.data.keys().hasAll(['id', 'type', 'amount', 'date', 'description', 'category', 'partner', 'createdAt'])
          && request.resource.data.keys().hasOnly(['id', 'type', 'amount', 'date', 'description', 'category', 'partner', 'createdAt'])
          && request.resource.data.id == entryId
          && request.resource.data.type in ['expense', 'revenue']
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 100000000000
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0
          && request.resource.data.description.size() <= 120
          && request.resource.data.partner is string
          && request.resource.data.partner.size() <= 60
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.createdAt is string
          && ((request.resource.data.type == 'revenue' && request.resource.data.category == 'Faturamento')
            || (request.resource.data.type == 'expense' && request.resource.data.category in ['Anúncios', 'BM', 'Domínio', 'Serviços', 'Outros']));
      }
    }
  }
}
